# Copy to .env and fill in from your Supabase + Google Cloud dashboards.
# .env is gitignored. Never commit real values.

# Supabase -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase -> Project Settings -> API Keys -> anon / publishable key
# (safe to ship to the browser; RLS is what protects the data)
VITE_ANON_KEY=your-anon-or-publishable-key

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
